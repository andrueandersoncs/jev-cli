{
  "name": "@andrueandersoncs/jev-cli",
  "version": "0.2.0",
  "description": "Ask TypeSafe AI typed questions about JSON state from the command line",
  "type": "module",
  "bin": {
    "jev": "dist/jev.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "bun": ">=1"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build ./index.ts --target=bun --outfile ./dist/jev.js",
    "jev": "bun run index.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "bun run typecheck && bun run build"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-rc.117",
    "@typesafe-ai/sdk": "^0.6.0",
    "effect": "4.0.0-rc.117"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7"
  },
  "license": "MIT"
}
